#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.4.2"
if [[ "$(uname -s)" == Darwin ]]; then
  DEFAULT_INSTALL_ROOT="$HOME/Library/Application Support/DocSort"
  DEFAULT_BACKUP_ROOT="$DEFAULT_INSTALL_ROOT/backups"
else
  DEFAULT_INSTALL_ROOT=/opt/docsort
  DEFAULT_BACKUP_ROOT=/var/backups/docsort
fi
INSTALL_ROOT="${DOCSORT_INSTALL_ROOT:-$DEFAULT_INSTALL_ROOT}"
BACKUP_ROOT="${DOCSORT_BACKUP_ROOT:-$DEFAULT_BACKUP_ROOT}"
COMPOSE_FILE="$INSTALL_ROOT/compose.yml"
ENV_FILE="$INSTALL_ROOT/docsort.env"
PROJECT_NAME="${DOCSORT_PROJECT_NAME:-}"
if [[ -z "$PROJECT_NAME" && -f "$ENV_FILE" ]]; then
  PROJECT_NAME="$(sed -n 's/^DOCSORT_PROJECT_NAME=//p' "$ENV_FILE")"
fi
PROJECT_NAME="${PROJECT_NAME:-docsort}"

say() { printf 'DocSort: %s\n' "$*"; }
die() { say "ERROR: $*" >&2; exit 1; }
require() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }
compose() { docker compose --project-name "$PROJECT_NAME" --file "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"; }

random_secret() {
  openssl rand -hex "$1"
}

write_compose() {
  local mode="$1"
  local ollama="$2"

  cat >"$COMPOSE_FILE" <<'YAML'
name: ${DOCSORT_PROJECT_NAME}

services:
  web:
    image: ${DOCSORT_IMAGE}
    restart: unless-stopped
    env_file: docsort.env
    environment:
      RAILS_ENV: production
      RAILS_LOG_LEVEL: info
      SOLID_QUEUE_IN_PUMA: "true"
      DOCSORT_SORTED_ROOT: /rails/storage/sorted
      DOCSORT_INBOX_ROOT: /rails/storage/inbox
      DOCSORT_AUTO_SEED: "true"
      DOCSORT_OCR_MODE: auto
      DOCSORT_OCR_LANGS: eng+deu
      DOCSORT_CLASSIFY_MAX_CHARS: "12000"
      DOCSORT_MAX_UPLOAD_BYTES: "104857600"
    volumes:
      - docsort_storage:/rails/storage
    extra_hosts:
      - "host.docker.internal:host-gateway"
    labels:
      service: docsort
      role: web
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://localhost/up"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
YAML

  if [[ "$mode" == lan ]]; then
    cat >>"$COMPOSE_FILE" <<'YAML'
    ports:
      - "${DOCSORT_PORT:-3000}:80"
YAML
  fi

  if [[ "$ollama" == true ]]; then
    cat >>"$COMPOSE_FILE" <<'YAML'
    depends_on:
      ollama:
        condition: service_started

  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    environment:
      OLLAMA_KEEP_ALIVE: 24h
    volumes:
      - ollama_data:/root/.ollama
YAML
  fi

  if [[ "$mode" == domain ]]; then
    cat >>"$COMPOSE_FILE" <<'YAML'

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on:
      web:
        condition: service_healthy
    ports:
      - "80:80"
      - "443:443"
    environment:
      DOCSORT_DOMAIN: ${DOCSORT_DOMAIN}
    command: ["caddy", "reverse-proxy", "--from", "${DOCSORT_DOMAIN}", "--to", "web:80"]
    volumes:
      - caddy_data:/data
      - caddy_config:/config
YAML
  fi

  cat >>"$COMPOSE_FILE" <<'YAML'

volumes:
  docsort_storage:
    name: ${DOCSORT_STORAGE_VOLUME}
YAML

  if [[ "$ollama" == true ]]; then
    printf '%s\n' '  ollama_data:' '    name: ${DOCSORT_OLLAMA_VOLUME}' >>"$COMPOSE_FILE"
  fi
  if [[ "$mode" == domain ]]; then
    printf '%s\n' '  caddy_data:' '  caddy_config:' >>"$COMPOSE_FILE"
  fi
}

valid_name() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9_.-]*$ ]]
}

port_in_use() {
  local port="$1"
  docker ps --format '{{.Ports}}' 2>/dev/null | grep -Eq "(^|, |:)$port->" && return 0
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 && return 0
  elif command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)$port$" && return 0
  fi
  return 1
}

install_command() {
  require docker
  require openssl
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required"

  local mode="${DOCSORT_MODE:-lan}"
  local domain="${DOCSORT_DOMAIN:-}"
  local port="${DOCSORT_PORT:-3000}"
  local image="${DOCSORT_IMAGE:-ghcr.io/timrauhut/docsort:stable}"
  local ollama="${DOCSORT_OLLAMA:-true}"
  local ollama_host="${OLLAMA_HOST:-http://ollama:11434}"
  local project_name="${DOCSORT_PROJECT_NAME:-docsort}"
  local storage_volume="${DOCSORT_STORAGE_VOLUME:-docsort_storage}"
  local ollama_volume="${DOCSORT_OLLAMA_VOLUME:-ollama_data}"
  local adopt_existing_volume=false
  local admin_password
  admin_password="$(random_secret 24)"

  while (($#)); do
    case "$1" in
      --domain) mode=domain; domain="${2:?missing domain}"; shift 2 ;;
      --lan) mode=lan; shift ;;
      --port) port="${2:?missing port}"; shift 2 ;;
      --image) image="${2:?missing image}"; shift 2 ;;
      --no-ollama) ollama=false; shift ;;
      --ollama-host) ollama=false; ollama_host="${2:?missing Ollama URL}"; shift 2 ;;
      --project-name) project_name="${2:?missing project name}"; shift 2 ;;
      --storage-volume) storage_volume="${2:?missing storage volume}"; shift 2 ;;
      --ollama-volume) ollama_volume="${2:?missing Ollama volume}"; shift 2 ;;
      --adopt-existing-volume) adopt_existing_volume=true; shift ;;
      --yes) shift ;;
      *) die "unknown install option: $1" ;;
    esac
  done

  [[ "$mode" == lan || "$mode" == domain ]] || die "mode must be lan or domain"
  [[ "$ollama" == true || "$ollama" == false ]] || die "DOCSORT_OLLAMA must be true or false"
  valid_name "$project_name" || die "invalid project name: $project_name"
  valid_name "$storage_volume" || die "invalid storage volume name: $storage_volume"
  valid_name "$ollama_volume" || die "invalid Ollama volume name: $ollama_volume"
  [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || die "invalid port: $port"
  [[ -n "$INSTALL_ROOT" && "$INSTALL_ROOT" != / && "$INSTALL_ROOT" != "$HOME" ]] \
    || die "unsafe installation root: $INSTALL_ROOT"
  if [[ "$mode" == domain ]]; then
    [[ "$domain" == *.* && "$domain" != *.local ]] || die "a registered public domain is required for automatic HTTPS"
    port_in_use 80 && die "port 80 is already in use"
    port_in_use 443 && die "port 443 is already in use"
  elif port_in_use "$port"; then
    die "port $port is already in use; choose another with --port"
  fi

  [[ ! -e "$INSTALL_ROOT" ]] || die "$INSTALL_ROOT already exists; use 'docsort update' or choose DOCSORT_INSTALL_ROOT"
  if docker volume inspect "$storage_volume" >/dev/null 2>&1 && [[ "$adopt_existing_volume" != true ]]; then
    die "Docker volume $storage_volume already exists; choose --storage-volume or explicitly use --adopt-existing-volume"
  fi

  local storage_volume_existed=false ollama_volume_existed=false install_complete=false
  PROJECT_NAME="$project_name"
  docker volume inspect "$storage_volume" >/dev/null 2>&1 && storage_volume_existed=true
  docker volume inspect "$ollama_volume" >/dev/null 2>&1 && ollama_volume_existed=true
  install_rollback() {
    local exit_code="${1:-$?}"
    trap - ERR
    if [[ "$install_complete" != true ]]; then
      say "Installation failed; removing partial containers and configuration"
      [[ -f "$COMPOSE_FILE" && -f "$ENV_FILE" ]] && compose down --remove-orphans >/dev/null 2>&1 || true
      [[ "$storage_volume_existed" == true ]] || docker volume rm "$storage_volume" >/dev/null 2>&1 || true
      if [[ "$ollama" == true && "$ollama_volume_existed" != true ]]; then
        docker volume rm "$ollama_volume" >/dev/null 2>&1 || true
      fi
      rm -rf "$INSTALL_ROOT"
    fi
    return "$exit_code"
  }
  trap install_rollback ERR

  install -d -m 0700 "$INSTALL_ROOT"

  umask 077
  cat >"$ENV_FILE" <<EOF
DOCSORT_IMAGE=$image
DOCSORT_MODE=$mode
DOCSORT_DOMAIN=$domain
DOCSORT_PORT=$port
DOCSORT_PROJECT_NAME=$project_name
DOCSORT_STORAGE_VOLUME=$storage_volume
DOCSORT_OLLAMA_VOLUME=$ollama_volume
SECRET_KEY_BASE=$(random_secret 64)
DOCSORT_SESSION_COOKIE=_${project_name//[^a-zA-Z0-9]/_}_session
DOCSORT_ADMIN_USERNAME=admin
DOCSORT_ADMIN_PASSWORD=$admin_password
DOCSORT_FRESH_INSTALL=$([[ "$storage_volume_existed" == true ]] && echo false || echo true)
DOCSORT_REQUIRE_INITIAL_PASSWORD_CHANGE=true
WEBDAV_PASSWORD=$admin_password
OLLAMA_HOST=$ollama_host
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=600
ASSUME_SSL=$([[ "$mode" == domain ]] && echo true || echo false)
FORCE_SSL=$([[ "$mode" == domain ]] && echo true || echo false)
DOCSORT_ALLOW_INSECURE_AUTH=$([[ "$mode" == lan ]] && echo true || echo false)
DOCSORT_ALLOW_INSECURE_WEBDAV=$([[ "$mode" == lan ]] && echo true || echo false)
EOF
  chmod 0600 "$ENV_FILE"
  write_compose "$mode" "$ollama"

  if [[ "${DOCSORT_DRY_RUN:-false}" == true ]]; then
    compose config --quiet
    say "Dry run complete: $COMPOSE_FILE"
    return
  fi

  if ! docker image inspect "$image" >/dev/null 2>&1; then
    say "Pulling $image"
    if ! docker pull "$image"; then
      say "ERROR: image unavailable; pass --image with a published multi-architecture image" >&2
      install_rollback 1
      return 1
    fi
  fi

  compose up --detach
  if [[ "$ollama" == true ]]; then
    say "Downloading Qwen 2.5 3B (first install only)"
    compose exec --no-TTY ollama ollama pull qwen2.5:3b
  fi

  say "Waiting for the application"
  local attempts=0
  until compose exec --no-TTY web curl --fail --silent http://localhost/up >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if ((attempts >= 60)); then
      compose logs --tail 100 web
      say "ERROR: application health check failed" >&2
      install_rollback 1
      return 1
    fi
    sleep 2
  done

  say "Installed successfully"
  install_complete=true
  trap - ERR
  if [[ "$mode" == domain ]]; then
    say "Open https://$domain"
  else
    local host_address=localhost
    if [[ "$(uname -s)" == Linux ]]; then
      host_address="$(hostname -I 2>/dev/null | awk '{print $1}')"
    fi
    say "Open http://$host_address:$port"
    say "LAN mode uses HTTP; use a domain install for browser-trusted HTTPS"
  fi
  printf '\n'
  if [[ "$storage_volume_existed" == true ]]; then
    say "EXISTING DATA ADOPTED"
    say "Use the accounts and passwords already stored in $storage_volume."
    say "The generated bootstrap password was not applied to existing users."
  else
    say "INITIAL SIGN-IN CREDENTIALS"
    say "Username: admin"
    say "Password: $admin_password"
    say "Save this password now. You can change it after signing in."
    say "The initial credentials are also stored securely in $ENV_FILE (mode 600)."
    if [[ "$(uname -s)" == Darwin ]]; then
      say "Before changing the password, show them again with: $HOME/.local/bin/docsort credentials --show"
    else
      say "Before changing the password, show them again with: sudo docsort credentials --show"
    fi
  fi
  printf '\n'
}

update_command() {
  [[ -f "$ENV_FILE" && -f "$COMPOSE_FILE" ]] || die "DocSort is not installed at $INSTALL_ROOT"

  local configured_image old_image_id new_image_id rollback_image
  configured_image="$(sed -n 's/^DOCSORT_IMAGE=//p' "$ENV_FILE")"
  [[ -n "$configured_image" ]] || die "DOCSORT_IMAGE is missing from $ENV_FILE"
  old_image_id="$(docker image inspect --format '{{.Id}}' "$configured_image" 2>/dev/null || true)"
  [[ -n "$old_image_id" ]] || die "installed image $configured_image was not found"

  say "Creating a verified backup before updating"
  backup_command

  say "Pulling updated containers"
  compose pull
  new_image_id="$(docker image inspect --format '{{.Id}}' "$configured_image" 2>/dev/null || true)"
  [[ -n "$new_image_id" ]] || die "updated image $configured_image was not found after pull"
  if [[ "$new_image_id" == "$old_image_id" ]]; then
    say "The installed DocSort image is already current; refreshing supporting containers"
  fi

  rollback_image="docsort-rollback:$(date -u +%Y%m%d%H%M%S)"
  docker image tag "$old_image_id" "$rollback_image"

  if ! compose up --detach --remove-orphans || ! wait_for_web_health 60; then
    say "Update failed; restoring the previous container image"
    DOCSORT_IMAGE="$rollback_image" compose up --detach --remove-orphans || \
      die "rollback could not start; run 'docsort logs web'"
    wait_for_web_health 60 || die "rollback started but did not become healthy; run 'docsort logs web'"
    die "update failed and the previous version was restored"
  fi

  docker image rm "$rollback_image" >/dev/null 2>&1 || true
  say "Update complete and healthy"
}

wait_for_web_health() {
  local max_attempts="$1"
  local attempts=0
  until compose exec --no-TTY web curl --fail --silent http://localhost/up >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    (( attempts < max_attempts )) || return 1
    sleep 2
  done
}

status_command() {
  [[ -f "$COMPOSE_FILE" ]] || die "DocSort is not installed"
  compose ps
  if [[ -f "$BACKUP_ROOT/status.env" ]]; then
    printf '\nBackup status:\n'
    cat "$BACKUP_ROOT/status.env"
  fi
}

backup_command() {
  if [[ "$(uname -s)" == Darwin ]]; then
    local backup_script="$INSTALL_ROOT/bin/docsort-backup-macos"
    [[ -x "$backup_script" ]] || die "backup service is not installed; reinstall without DOCSORT_SKIP_BACKUPS=true"
    "$backup_script"
  else
    command -v systemctl >/dev/null 2>&1 || die "systemd is required for managed backups"
    systemctl cat docsort-backup.service >/dev/null 2>&1 \
      || die "backup service is not installed; reinstall without DOCSORT_SKIP_BACKUPS=true"
    systemctl start docsort-backup.service
  fi
  say "Backup completed"
  [[ -f "$BACKUP_ROOT/status.env" ]] && cat "$BACKUP_ROOT/status.env"
}

backup_status_command() {
  [[ -f "$BACKUP_ROOT/status.env" ]] \
    || die "no backup status exists yet; run 'docsort backup'"
  cat "$BACKUP_ROOT/status.env"
}

credentials_command() {
  [[ -f "$ENV_FILE" ]] || die "DocSort is not installed at $INSTALL_ROOT"
  if [[ "$(sed -n 's/^DOCSORT_FRESH_INSTALL=//p' "$ENV_FILE")" == false ]]; then
    say "This installation adopted existing data; use its existing account credentials."
    return
  fi
  if [[ "${1:-}" == --show ]]; then
    say "Initial admin username: $(sed -n 's/^DOCSORT_ADMIN_USERNAME=//p' "$ENV_FILE")"
    say "Initial admin password: $(sed -n 's/^DOCSORT_ADMIN_PASSWORD=//p' "$ENV_FILE")"
    say "The password above is no longer valid if it was changed in the web app."
  else
    say "Initial installation credentials are stored in $ENV_FILE (mode 600)."
    if [[ "$(uname -s)" == Darwin ]]; then
      say "Run 'docsort credentials --show' to reveal them."
    else
      say "Run 'sudo docsort credentials --show' to reveal them."
    fi
  fi
}

doctor_command() {
  local failed=0
  for command in docker openssl; do
    if command -v "$command" >/dev/null 2>&1; then say "OK $command"; else say "FAIL $command"; failed=1; fi
  done
  if docker compose version >/dev/null 2>&1; then say "OK Docker Compose"; else say "FAIL Docker Compose"; failed=1; fi
  if [[ -f "$ENV_FILE" ]]; then
    [[ "$(stat -c %a "$ENV_FILE" 2>/dev/null || stat -f %Lp "$ENV_FILE")" == 600 ]] \
      && say "OK secrets permissions" || { say "FAIL secrets permissions"; failed=1; }
  fi
  if [[ -f "$COMPOSE_FILE" ]]; then compose config --quiet || failed=1; fi
  return "$failed"
}

uninstall_command() {
  [[ "${1:-}" == --confirm ]] || die "uninstall preserves data; rerun: docsort uninstall --confirm"
  [[ -f "$COMPOSE_FILE" ]] || die "DocSort is not installed"
  compose down
  say "Containers removed. Data volume docsort_storage and $INSTALL_ROOT were preserved."
}

case "${1:-help}" in
  install) shift; install_command "$@" ;;
  update) update_command ;;
  status) status_command ;;
  logs) shift; compose logs "$@" ;;
  backup) backup_command ;;
  backup-status) backup_status_command ;;
  credentials) shift; credentials_command "$@" ;;
  doctor) doctor_command ;;
  uninstall) shift; uninstall_command "$@" ;;
  version|--version) echo "$VERSION" ;;
  help|--help|-h)
    cat <<EOF
Usage: docsort COMMAND

  install [--domain NAME|--lan] [--port N] [--image IMAGE] [--no-ollama]
          [--ollama-host URL] [--project-name NAME] [--storage-volume NAME]
          [--ollama-volume NAME] [--adopt-existing-volume]
  update | status | logs | backup | backup-status | credentials | doctor
  uninstall --confirm
EOF
    ;;
  *) die "unknown command: $1" ;;
esac
