# Copy to secrets (already present) or use as a checklist.
# Never commit real passwords.

RAILS_MASTER_KEY=$(cat config/master.key)
WEBDAV_PASSWORD=${WEBDAV_PASSWORD:?Set WEBDAV_PASSWORD before deploying}

