# Kamal secrets — sourced at deploy time. Safe patterns only (no raw secrets in git).
# Docs: https://kamal-deploy.org/docs/configuration/environment-variables/

# Rails credentials master key (required)
RAILS_MASTER_KEY=$(cat config/master.key)

# WebDAV basic-auth password (required in production — set in your shell or CI)
#   export WEBDAV_PASSWORD='a-long-random-string'
WEBDAV_PASSWORD=${WEBDAV_PASSWORD:?Set WEBDAV_PASSWORD in your environment before deploying}

# Registry auth (uncomment when using Docker Hub / GHCR instead of localhost:5555)
# KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME:?}
# KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:?}

# Optional GitHub token for private gems / status hooks
# GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token 2>/dev/null)}
