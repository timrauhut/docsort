# Kamal secrets — sourced at deploy time. Safe patterns only (no raw secrets in git).
# Docs: https://kamal-deploy.org/docs/configuration/environment-variables/

# Rails credentials master key (required)
RAILS_MASTER_KEY=$(cat config/master.key)

# LAN TLS certificate generated locally with mkcert. The entire directory is
# gitignored; Kamal uploads these values to kamal-proxy during deploy.
test -f config/tls/docsort.pem || { echo "Run bin/setup-lan-tls before deploying" >&2; exit 1; }
test -f config/tls/docsort-key.pem || { echo "Run bin/setup-lan-tls before deploying" >&2; exit 1; }
DOCSORT_TLS_CERTIFICATE=$(cat config/tls/docsort.pem)
DOCSORT_TLS_PRIVATE_KEY=$(cat config/tls/docsort-key.pem)

# Bootstrap admin password for web UI + WebDAV seed.
# Prefer DOCSORT_ADMIN_PASSWORD; WEBDAV_PASSWORD is a legacy alias.
#   export DOCSORT_ADMIN_PASSWORD='a-long-random-string'
if [ -n "${DOCSORT_ADMIN_PASSWORD:-}" ]; then
  DOCSORT_ADMIN_PASSWORD="$DOCSORT_ADMIN_PASSWORD"
elif [ -n "${WEBDAV_PASSWORD:-}" ]; then
  DOCSORT_ADMIN_PASSWORD="$WEBDAV_PASSWORD"
else
  echo "Set DOCSORT_ADMIN_PASSWORD before deploying" >&2
  exit 1
fi
