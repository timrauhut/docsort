#!/usr/bin/env bash
set -euo pipefail

echo "==> [pre-deploy] Preparing to deploy ${KAMAL_VERSION:-unknown} → ${KAMAL_HOSTS:-hosts}"
echo "    command=${KAMAL_COMMAND:-deploy} destination=${KAMAL_DESTINATION:-default}"

# Fail fast if required env file pieces are missing (secrets are loaded by Kamal separately)
if [[ ! -f config/deploy.yml ]]; then
  echo "ERROR: config/deploy.yml not found" >&2
  exit 1
fi

echo "==> [pre-deploy] OK"
