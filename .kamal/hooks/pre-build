#!/usr/bin/env bash
set -euo pipefail

echo "==> [pre-build] DocSort Kamal pre-build checks"

if [[ ! -f config/master.key ]]; then
  echo "ERROR: config/master.key missing. Rails needs it for RAILS_MASTER_KEY." >&2
  exit 1
fi

if [[ -z "${WEBDAV_PASSWORD:-}" ]]; then
  echo "ERROR: WEBDAV_PASSWORD is not set in the environment." >&2
  echo "  export WEBDAV_PASSWORD='your-strong-password'" >&2
  exit 1
fi

if [[ "$WEBDAV_PASSWORD" == "change-me-in-production" || "$WEBDAV_PASSWORD" == "upload123" ]]; then
  echo "WARNING: WEBDAV_PASSWORD looks like a default/dev password. Prefer a strong secret." >&2
fi

# Ensure production assets can build (tailwind)
if [[ ! -f app/assets/tailwind/application.css ]]; then
  echo "ERROR: app/assets/tailwind/application.css missing." >&2
  exit 1
fi

echo "==> [pre-build] OK (performer=${KAMAL_PERFORMER:-?} version=${KAMAL_VERSION:-?})"
