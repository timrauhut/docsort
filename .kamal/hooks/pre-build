#!/usr/bin/env bash
set -euo pipefail

echo "==> [pre-build] DocSort Kamal pre-build checks"

if [[ ! -f config/master.key ]]; then
  echo "ERROR: config/master.key missing. Rails needs it for RAILS_MASTER_KEY." >&2
  exit 1
fi

ADMIN_PASS="${DOCSORT_ADMIN_PASSWORD:-${WEBDAV_PASSWORD:-}}"
if [[ -z "$ADMIN_PASS" ]]; then
  echo "ERROR: DOCSORT_ADMIN_PASSWORD (or WEBDAV_PASSWORD) is not set." >&2
  echo "  export DOCSORT_ADMIN_PASSWORD='your-strong-password'" >&2
  exit 1
fi

if [[ "$ADMIN_PASS" == "change-me-in-production" || "$ADMIN_PASS" == "upload123" || "$ADMIN_PASS" == "changeme" ]]; then
  echo "WARNING: admin password looks like a default/dev password. Prefer a strong secret." >&2
fi

# Ensure production assets can build (tailwind)
if [[ ! -f app/assets/tailwind/application.css ]]; then
  echo "ERROR: app/assets/tailwind/application.css missing." >&2
  exit 1
fi

echo "==> [pre-build] OK (performer=${KAMAL_PERFORMER:-?} version=${KAMAL_VERSION:-?})"
