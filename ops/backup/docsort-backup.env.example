# Installed as /etc/docsort-backup.env with mode 0600.
DOCSORT_BACKUP_ROOT=/var/backups/docsort
DOCSORT_LOCAL_REPOSITORY=/var/backups/docsort/restic
DOCSORT_RESTIC_PASSWORD_FILE=/etc/docsort-backup-password
DOCSORT_RESTIC_CACHE_DIR=/var/backups/docsort/cache
DOCSORT_STORAGE_VOLUME=docsort_storage
DOCSORT_BACKUP_MIN_FREE_PERCENT=20

# Cloudflare R2: uncomment after creating a bucket-scoped API token.
# DOCSORT_R2_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET/docsort
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto
