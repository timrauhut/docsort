# Copy values into your shell or a local untracked env file before deploy.
# Do NOT commit real secrets.

# Required
export WEBDAV_PASSWORD='generate-a-long-random-password'

# Optional model pull override (bin/kamal-setup / bin/kamal-ollama pull)
export OLLAMA_PULL_MODEL='llama3.2'
# On Raspberry Pi 5 prefer:
# export OLLAMA_PULL_MODEL='llama3.2:1b'

# Registry (when not using localhost:5555)
# export KAMAL_REGISTRY_USERNAME='you'
# export KAMAL_REGISTRY_PASSWORD='token'

# Optional
# export GITHUB_TOKEN='ghp_...'
