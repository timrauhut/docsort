<%= form_with model: user, local: true do |f| %>
  <% if user.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <ul style="margin:0;padding-left:1.1rem">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :username %>
    <%= f.text_field :username, class: "input", required: true, autocomplete: "username" %>
  </div>

  <div class="field">
    <%= f.label :password, user.persisted? ? "New password (leave blank to keep)" : "Password" %>
    <%= f.password_field :password, class: "input", autocomplete: "new-password", required: !user.persisted? %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm password" %>
    <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
  </div>

  <div class="field" style="display:flex;align-items:center;gap:0.5rem">
    <%= f.check_box :admin %>
    <%= f.label :admin, "Admin (can manage users)" %>
  </div>

  <div style="margin-top:1.25rem">
    <%= f.submit user.persisted? ? "Save user" : "Create user",
          class: "btn btn-upload", style: "border:none;cursor:pointer;font:inherit" %>
  </div>
<% end %>
