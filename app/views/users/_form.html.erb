<%= form_with model: user, local: true, class: "auth-form user-form" do |f| %>
  <% if user.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <ul style="margin:0;padding-left:1.1rem">
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :username %>
    <%= f.text_field :username, class: "input", required: true, autocomplete: "username" %>
  </div>

  <div class="field">
    <%= f.label :password, user.persisted? ? "New password (leave blank to keep)" : "Password" %>
    <%= f.password_field :password, class: "input", autocomplete: "new-password", required: !user.persisted? %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "Confirm password" %>
    <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
  </div>

  <label class="user-form__check">
    <%= f.check_box :admin %>
    <span>
      <strong>Admin</strong>
      <span class="list-meta" style="margin:0">Can manage users and see the Users nav item</span>
    </span>
  </label>

  <div class="actions-row" style="margin-top:1.25rem">
    <%= f.submit user.persisted? ? "Save user" : "Create user", class: "btn btn-primary" %>
    <%= link_to "Cancel", users_path, class: "btn btn-ghost" %>
  </div>
<% end %>
