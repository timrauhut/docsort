<% content_for :title, "Edit · DocSort" %>

<div class="narrow">
  <div class="page-hero">
    <div>
      <p class="eyebrow">Edit</p>
      <h1>Document</h1>
      <p class="lede"><%= @document.original_filename %></p>
    </div>
  </div>

  <%= form_with model: @document, class: "form-card field-stack" do |f| %>
    <% if @document.errors.any? %>
      <div class="flash flash-alert"><%= @document.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title %>
    </div>
    <div>
      <%= f.label :summary, class: "form-label" %>
      <%= f.text_area :summary, rows: 4 %>
    </div>
    <div>
      <%= f.label :tags, "Tags (comma-separated)", class: "form-label" %>
      <%= f.text_field :tags %>
    </div>
    <div>
      <%= f.label :category_id, "Category", class: "form-label" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: "Unassigned" } %>
    </div>
    <div>
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, Document::STATUSES %>
    </div>

    <div class="actions-row">
      <%= f.submit "Save changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", @document, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
